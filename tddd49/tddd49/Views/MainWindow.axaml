<Window x:Class="tddd49.Views.MainWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:tddd49.ViewModels" Title="tddd49" d:DesignHeight="850"
        d:DesignWidth="1450" x:DataType="vm:MainWindowViewModel" Icon="/Assets/daniel.ico" mc:Ignorable="d" x:Name="mainWin">

    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <StackPanel Background="BurlyWood">
        <Border Margin="10" Padding="10" Background="AntiqueWhite" BorderBrush="Black" BorderThickness="1" CornerRadius="10">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                <Span Foreground="Black">Welcome to Chat App</Span>
            </TextBlock>
        </Border>
        <Grid ColumnDefinitions="1*, 5*, 1*">
            <StackPanel Grid.Column="0">
                <Label Margin="10" HorizontalAlignment="Left" Foreground="Black">
                    Display Name
                </Label>
                <TextBlock HorizontalAlignment="Center" />
                <TextBox Margin="10,0,0,0" HorizontalContentAlignment="Stretch" Background="DimGray" BorderBrush="Black" CornerRadius="20" Foreground="white"
                         Text="{Binding username}" />
                <Label Margin="10" HorizontalAlignment="Left" Foreground="Black">
                    IP-address
                </Label>
                <TextBox Margin="10,0,0,0" HorizontalContentAlignment="Stretch" Background="DimGray" BorderBrush="Black" CornerRadius="20" Foreground="white"
                         Text="{Binding ip_address}" />
                
                <Label Margin="10" HorizontalAlignment="Left" Foreground="Black">
                    PORT
                </Label>
                <TextBox Margin="10,0,0,0" HorizontalContentAlignment="Stretch" Background="DimGray" BorderBrush="Black" CornerRadius="20" Foreground="white"
                         Text="{Binding port}" />
                <Button Margin="10,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding start}"
                        CornerRadius="20">
                    <Viewbox>
                        <TextBlock HorizontalAlignment="Center" Foreground="Black">Start</TextBlock>
                    </Viewbox>
                </Button>
                <Button Margin="10,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding connect}"
                        CornerRadius="20">
                    <Viewbox>
                        <TextBlock HorizontalAlignment="Center" Foreground="Black">Connect</TextBlock>
                    </Viewbox>
                </Button>
                <TextBlock HorizontalAlignment="Center" Foreground="Green"
                           Text="{Binding status_message}" />
            </StackPanel>
            <Border Grid.Column="1" Margin="10" Background="AntiqueWhite" BorderBrush="Black" BorderThickness="2" CornerRadius="20">
                <Grid RowDefinitions="8*, 1*">
                    <StackPanel Grid.Row="0" >
                        <ItemsControl ItemsSource="{Binding message_list}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="10,10,0,0"
                                            CornerRadius="5"
                                            BorderBrush="Gray" BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0, 0, 5, 0" Foreground="red" Text="{Binding From}"/>
                                            <TextBlock Foreground="Black" Text="{Binding Message}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="10" ColumnDefinitions="11*, 1*, 1*">
                        <TextBox Grid.Column="0" Text="{Binding send_message}" HorizontalContentAlignment="Stretch" Background="AntiqueWhite" BorderBrush="Black" CornerRadius="20" />
                        <Button Grid.Column="1" Command="{Binding send_message_button}" Margin="5,0,0,0" CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center" Foreground="Black">Send</TextBlock>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding buzz}" Margin="5,0,0,0" CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center" Foreground="Black">Buzz</TextBlock>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" Margin="0,10,10,10" >
                <Button Margin="0,10,0,10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding disconnect}"
                        CornerRadius="20">
                    <Viewbox>
                        <TextBlock HorizontalAlignment="Center" Foreground="Black">Disconnect </TextBlock>
                    </Viewbox>
                </Button>
                <Border BorderThickness="2" BorderBrush="Black" CornerRadius="20" Background="AntiqueWhite">
                    <StackPanel>
                        <TextBlock Margin="10">
                            <Span Foreground="Black">Chat History:</Span>
                        </TextBlock>
                        <TextBox Text="{Binding search_history}" HorizontalContentAlignment="Stretch" Background="AntiqueWhite" BorderBrush="Black" CornerRadius="20" Margin="5 0 5 0" />                        
                        
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding history_list}" Padding="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="10,10,0,0" 
                                                CornerRadius="5"
                                                BorderBrush="Gray" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,0,0" Command="{Binding DataContext.show_conversation, ElementName=mainWin}" CommandParameter="{Binding Item2}">
                                                    <TextBlock Foreground="Black" Text="{Binding Item1}"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>